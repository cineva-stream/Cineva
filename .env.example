# Cineva Environment Variables Example
# Copy this file to `.env` and fill in your 16-digit Google App Password for `noreply.cineva@gmail.com`.
#
# Local run / build:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# GitHub Actions (Repository Secret `CINEVA_SMTP_APP_PASSWORD`):
#   flutter build apk --dart-define=CINEVA_SMTP_APP_PASSWORD=${{ secrets.CINEVA_SMTP_APP_PASSWORD }}

CINEVA_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
